; ─── Layout ─────────────────────────────────────────────────────────────────
; Left half   → MoveJoystick (DYNAMIC) · Jump & Run buttons above thumb zone
; Right half  → LookJoystick (DYNAMIC) · Flash, Inventory, Interact above thumb
; All nodes   → modulate alpha 0.55  (see-through, non-intrusive)
; Buttons     → flat=true + expand_icon=true → pure 3D icon, no box border
; ─────────────────────────────────────────────────────────────────────────────

[node name="TouchControllers" type="CanvasLayer"]

; ── LEFT joystick: movement ───────────────────────────────────────────────────
[node name="MoveJoystick" parent="." instance=ExtResource("1_j3kvq")]
anchor_left = 0.0
anchor_top = 0.0
anchor_right = 0.5
anchor_bottom = 1.0
offset_left = 0.0
offset_top = 0.0
offset_right = 0.0
offset_bottom = 0.0
modulate = Color(1, 1, 1, 0.55)
joystick_mode = 1
visibility_mode = 0
; NOTE: player.gd reads Input.get_vector("right","left","forward","back") —
; action names are intentionally swapped to match AZERTY key layout.
; Joystick must mirror that swap so drag-left = strafe-left, drag-right = strafe-right.
action_left = "right"
action_right = "left"
action_up = "forward"
action_down = "back"

; ── RIGHT joystick: camera look ───────────────────────────────────────────────
[node name="LookJoystick" parent="." instance=ExtResource("1_j3kvq")]
anchor_left = 0.5
anchor_top = 0.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 0.0
offset_top = 0.0
offset_right = 0.0
offset_bottom = 0.0
modulate = Color(1, 1, 1, 0.55)
joystick_mode = 1
visibility_mode = 0
action_left = "look_left"
action_right = "look_right"
action_up = "look_up"
action_down = "look_down"

; ══════════════════════════════════════════════════════════════════════════════
; ACTION BUTTONS  (rendered after joysticks → on top → consume touch first)
; Size: 90×90 px.  flat=true removes the box border; only the 3D icon shows.
; ══════════════════════════════════════════════════════════════════════════════

; ── LEFT buttons: Jump & Run ──────────────────────────────────────────────────

